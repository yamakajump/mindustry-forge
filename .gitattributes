# The repository stores everything in LF. Without this rule a file edited on
# Windows goes in as CRLF, and the deployment scripts copied onto the server
# fail on an invisible `\r` in the shebang.
* text=auto eol=lf

# Files that must stay LF whatever happens: they are run by bash or read by
# systemd on the server.
*.sh        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf

# Binaries: never touched.
*.png       binary
*.jpg       binary
*.ico       binary
*.msch      binary
*.jar       binary
*.gz        binary
