[Unit]
Description=Triggers the mindustry-forge backup

[Timer]
# 03:15: after the panel's (03:00) and before delicieux's (03:32), so
# that the three dumps do not tread on each other on the same disk.
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
