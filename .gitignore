site/bootstrap/cache/*

# Fiches projet : contexte de travail, pas du code.
.claude/projet/

# Execution plans: dated, step-by-step, written for whoever is running them that
# day. Nobody updates a plan once its work has landed, so it is scaffolding, not
# documentation, and it does not get committed.
#
# What is worth keeping from one is the reasoning behind a decision, and that
# lives in docs/decisions/, tracked and indexed there. This line is what keeps
# the two apart: a plan can grow here freely, and nothing in docs/decisions/ is
# ever swept up by it because that directory is not this one.
docs/plans/

# The log tooled sessions keep as they work: drafts, not code.
# Working notes of a tooled session: regenerable from git log.
.superpowers/
