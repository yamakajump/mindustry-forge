__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
node_modules/

# The frame-by-frame traces: a megabyte per scenario, regenerable on both sides, and read
# once while hunting for the frame where the two engines part ways.
bench/data/trace/
bench/data/trace-run.json

# The art direction's scratch pad: contact sheets, rejected variants, trial shots. What
# comes out of it good is committed under site/public/brand/.
_da/

# The test server and what it writes. The game's jar is not committed.
_run/
bench/build/
bench/.gradle/
bench/bridge-old/
mindustry-forge/

# Laravel
site/vendor/
site/node_modules/
site/.env
site/storage/*.key
site/storage/framework/cache/*
site/storage/framework/sessions/*
site/storage/framework/views/*
site/storage/logs/*
site/storage/app/public/apercus/*
site/public/storage
site/public/build/
site/database/*.sqlite
site/bootstrap/cache/*

# Project notes: working context, not code.
.claude/projet/

# Execution plans: dated, step-by-step, written for whoever is running them that
# day. Nobody updates a plan once its work has landed, so it is scaffolding, not
# documentation, and it does not get committed.
#
# What is worth keeping from one is the reasoning behind a decision, and that
# lives in docs/decisions/, tracked and indexed there. This line is what keeps
# the two apart: a plan can grow here freely, and nothing in docs/decisions/ is
# ever swept up by it because that directory is not this one.
docs/plans/

# The working notes a tooled session keeps as it goes: drafts, regenerable from git log.
.superpowers/
