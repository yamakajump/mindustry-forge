# captures d'essai. Ce qui en sort de bon est versionne dans site/public/brand/.
_da/

# Le serveur de test et ce qu il ecrit. Le jar du jeu ne se versionne pas.
_run/
bench/build/
bench/.gradle/
bench/bridge-old/
mindustry-forge/

# Laravel
site/vendor/
site/node_modules/
site/.env
site/storage/*.key
site/storage/framework/cache/*
site/storage/framework/sessions/*
site/storage/framework/views/*
site/storage/logs/*
site/storage/app/public/apercus/*
site/public/storage
site/public/build/
