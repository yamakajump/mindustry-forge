# EditorConfig: https://editorconfig.org
#
# Line endings are already fixed by .gitattributes (LF everywhere); this file
# only covers what that one does not, indentation and whitespace, matched to
# what each language in this repository already does in practice rather than
# a convention imposed on top of it.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# PHP (site/app, site/routes, site/tests): four-space indent throughout.
[*.php]
indent_size = 4

# Python (bench/, tests/): PEP 8, four spaces.
[*.py]
indent_size = 4

# Java (bench/bridge-old): four spaces, the language's own convention.
[*.java]
indent_size = 4

# The analysis engine and its tests, plus tooling scripts: two spaces.
[*.{js,mjs,cjs}]
indent_size = 2

# Blade templates nest their PHP and HTML at two spaces.
[*.blade.php]
indent_size = 2

# GitHub Actions workflows and Dependabot config: two spaces.
[*.{yml,yaml}]
indent_size = 2

# package.json is hand-maintained at two spaces; composer.json is
# regenerated by Composer at its own four-space default and is left out
# here rather than fought on every install.
[package.json]
indent_size = 2

# Markdown relies on a trailing two-space line break to force one; trimming
# it would silently rejoin lines that were split on purpose.
[*.md]
trim_trailing_whitespace = false

# Deployment scripts run through bash on the production server; matches the
# LF rule .gitattributes already gives them.
[*.sh]
indent_size = 4
end_of_line = lf
